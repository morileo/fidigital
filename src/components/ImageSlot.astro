---
/**
 * Substitui o <image-slot> do editor visual original.
 * Sem `src`, mostra um placeholder tracejado com a descrição da imagem esperada.
 * Com `src` (import de src/assets ou URL), renderiza a imagem.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string;
  shape?: 'rect' | 'rounded' | 'circle' | 'pill';
  radius?: number | string;
  fit?: 'cover' | 'contain';
  placeholder?: string;
  style?: string;
  src?: ImageMetadata | string;
  alt?: string;
}

const {
  id,
  shape = 'rounded',
  radius = 12,
  fit = 'cover',
  placeholder = 'Adicione uma imagem',
  style = '',
  src,
  alt = placeholder,
} = Astro.props;

const borderRadius =
  shape === 'rect' ? '0' :
  shape === 'circle' ? '50%' :
  shape === 'pill' ? '9999px' :
  `${radius}px`;

const frameStyle = `display:block;position:relative;overflow:hidden;border-radius:${borderRadius};${style}`;
const imgStyle = `display:block;width:100%;height:100%;object-fit:${fit}`;
---

<div id={id} class="image-slot" style={frameStyle}>
  {src ? (
    typeof src === 'string'
      ? <img src={src} alt={alt} style={imgStyle} loading="lazy" />
      : <Image src={src} alt={alt} style={imgStyle} />
  ) : (
    <div class="image-slot__empty">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <path d="M21 15l-5-5L5 21"></path>
      </svg>
      <span>{placeholder}</span>
    </div>
  )}
</div>

<style>
  .image-slot__empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.6;
    border: 1.5px dashed currentColor;
    border-radius: inherit;
  }
</style>
