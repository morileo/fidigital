<style is:global>
  html { scroll-behavior: smooth; }
  body { margin: 0; background: #112233; }
  a { color: #c8a96e; text-decoration: none; }
  a:hover { color: #dbbe8f; }
  #hero {
    display: grid;
    gap: 0 56px;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    grid-template-areas: "kicker media" "title media" "sub media" "body media" "pull media" "price media" "cta media" "trust media";
    align-content: center;
  }
  #sticky { display: none; }
  @media (max-width: 1100px) {
    #xadrez { display: none; }
  }
  @media (max-width: 900px) {
    #hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      grid-template-areas: "kicker" "title" "media" "sub" "body" "pull" "price" "cta" "trust";
    }
    #sticky { display: flex; }
    #hero-media { margin: 28px 0 32px; }
    body { padding-bottom: 96px; }
  }

  /* Estados de hover/clique dos botões (substituem style-hover/style-active) */
  a.hover-gold:hover { background: #dbbe8f !important; color: #112233; }
  a.hover-navy:hover { background: #254e6d !important; }
  a.press:active { transform: scale(0.97) !important; }
</style>
